<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme for activities. Compose supplies its own Material3 theme on top,
         but we keep a dark, transparent system chrome to avoid flashes. -->
    <style name="Theme.Salt" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/salt_background</item>
        <item name="android:colorBackground">@color/salt_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
