<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== Core permissions ===================== -->
    <!-- Overlay / quick-settings shade -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service hosting the overlay -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Notifications (status / errors) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AI layer network access (Phase 2) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Modify system settings (brightness, etc. — Phase 2) -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Do-Not-Disturb / interruption filter -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Flashlight (torch) -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!-- Bluetooth (legacy + modern) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Shizuku manager API permission (bridge activated from the manager app) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Let Salt detect / launch the Shizuku manager app -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".SaltApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Salt">

        <!-- Launcher / control screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Salt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Permission onboarding -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Salt" />

        <!-- Foreground overlay service hosting the Jetpack Compose control center -->
        <service
            android:name=".core.overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Required description for the special-use foreground service type (API 34+). -->
            <property
                android:name="android.service.foreground.special_use"
                android:value="Salt custom control-center overlay &amp; quick-settings shade" />
        </service>

        <!-- Notification listener (Phase 2 — intercept + sanitize before AI) -->
        <service
            android:name=".core.notifications.SaltNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Shizuku provider bridge (Phase 2 usage) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
